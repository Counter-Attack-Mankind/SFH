{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MOD",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build MOD (weapon pack)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1",
        "-Config", "src/configs/custom_weapon_pack.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Verify MOD",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/verify.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Verify MOD (weapon pack)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/verify.ps1",
        "-Config", "src/configs/custom_weapon_pack.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Validate Config",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/validate-config.ps1",
        "-Config", "src/configs/custom_weapon_pack.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "List Weapons",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/list-weapons.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Inspect SWF",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/inspect.ps1",
        "-Config", "src/configs/custom_weapon_pack.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test MOD",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
